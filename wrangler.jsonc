{
  // Strona (public/) + Worker z wspólnym zapisem postępu (Durable Object, SQLite – działa na darmowym planie).
  "name": "lego-wybor",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // Własny adres (domena mariollo.com jest w Cloudflare); Cloudflare sam zakłada rekord DNS i certyfikat.
  "routes": [{ "pattern": "lego.mariollo.com", "custom_domain": true }],
  // Stary adres lego-wybor.mariollo.workers.dev zostaje na razie jako zapasowy.
  "workers_dev": true,
  // Workery z Durable Objects nie obsługują preview URL.
  "preview_urls": false,
  // Zachowaj zmienne dodane w panelu Cloudflare przy kolejnych wdrożeniach z GitHuba.
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "FamilyStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FamilyStore"] }]
}
